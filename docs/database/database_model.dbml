// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Table situations {
  id number [primary key]
  description varchar [not null]
  slug varchar [not null]
}

Table roles {
  id number [primary key]
  description varchar [unique, not null]
  slug varchar [unique, not null]
}

Table users_roles {
  role_id number [ref: > roles.id, not null, primary key]
  user_uuid uuid [ref: > users.uuid, not null, primary key]
  access_date datetime [not null]
}

Table plans {
  id number [primary key]
  name varchar [not null]
  description varchar [not null]
  slug varchar [not null, unique]
  price decimal(10, 3)
  max_storage_mb number
}

Table users {
  uuid uuid [primary key]
  email varchar [unique, not null]
  username varchar [unique, not null]
  password varchar [not null]
  created timestamp [not null]
  modified timestamp
  situation_id number [not null, ref: > situations.id]
}

Table user_subscriptions {
  id number [primary key]
  user_uuid uuid [ref: > users.uuid, not null, unique]
  plan_id number [ref: > plans.id, not null]
  start_date timestamp [not null]
  end_date timestamp
  subscription_token varchar [unique, not null]
  payment_status varchar [not null]
  card_last4 varchar
  card_brand varchar
}

Table texts_situations {
  id number [primary key]
  description varchar [unique, not null]
  slug varchar [unique, not null]
}

Table texts {
  id number [primary key]
  title varchar [not null]
  description text [not null]
  text_own_uuid uuid [ref: > users.uuid, not null]
  situation_text_id number [ref: > texts_situations.id, not null]
}
